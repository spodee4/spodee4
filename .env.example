# ============================================================
# Massage Booking App — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# --- Admin Login ---
ADMIN_PASSWORD=changeme

# --- Business Info ---
BUSINESS_NAME=Healing Hands Massage
THERAPIST_NAME=John Smith
BUSINESS_PHONE=(555) 123-4567
BUSINESS_EMAIL=info@healinghandsmassage.com
BUSINESS_ADDRESS=123 Main St, Suite 100, Anytown, USA

# --- Email Notifications (optional — uses nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
NOTIFY_FROM=noreply@healinghandsmassage.com

# --- SMS via Twilio (optional) ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# --- Vault (optional — centralized credential management) ---
VAULT_URL=
VAULT_PIN=
VAULT_TOKEN=
