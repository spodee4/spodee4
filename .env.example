# ============================================================
# Mx — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================
# Vault integration (recommended): set VAULT_URL + VAULT_PIN
# and credentials are read from the JC Dashboard vault.
# If vault is unreachable, falls back to env vars below.
# ============================================================

# --- Vault (optional — enables centralized credential management) ---
VAULT_URL=http://192.168.51.64:5160
VAULT_PIN=
VAULT_TOKEN=cb-local-2026

# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# --- Claude API (fallback if vault unavailable) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Zoho Business Email (fallback if vault unavailable) ---
ZOHO_BIZ_HOST=imap.zoho.com
ZOHO_BIZ_PORT=993
ZOHO_BIZ_USER=you@yourdomain.com
ZOHO_BIZ_PASS=your-app-password
ZOHO_BIZ_SMTP_HOST=smtp.zoho.com
ZOHO_BIZ_SMTP_PORT=465

# --- Zoho Website/Contact Email (fallback if vault unavailable) ---
ZOHO_WEB_HOST=imap.zoho.com
ZOHO_WEB_PORT=993
ZOHO_WEB_USER=contact@yourdomain.com
ZOHO_WEB_PASS=your-app-password
ZOHO_WEB_SMTP_HOST=smtp.zoho.com
ZOHO_WEB_SMTP_PORT=465

# --- Gmail Personal (fallback if vault unavailable) ---
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_USER=you@gmail.com
GMAIL_PASS=your-app-password
