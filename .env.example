# Mx — Environment Configuration
# Copy this to .env and fill in your values

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Zoho Business Email (IMAP)
ZOHO_BIZ_HOST=imap.zoho.com
ZOHO_BIZ_PORT=993
ZOHO_BIZ_USER=you@yourdomain.com
ZOHO_BIZ_PASS=your-app-password
ZOHO_BIZ_SMTP_HOST=smtp.zoho.com
ZOHO_BIZ_SMTP_PORT=465

# Zoho Website/Contact Email (IMAP)
ZOHO_WEB_HOST=imap.zoho.com
ZOHO_WEB_PORT=993
ZOHO_WEB_USER=contact@yourdomain.com
ZOHO_WEB_PASS=your-app-password
ZOHO_WEB_SMTP_HOST=smtp.zoho.com
ZOHO_WEB_SMTP_PORT=465

# Gmail Personal (OAuth2)
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_USER=you@gmail.com

# Server
PORT=3000
